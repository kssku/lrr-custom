#!/bin/sh

USER_ID=${LRR_UID}
GROUP_ID=${LRR_GID}
FIX_PERMS=${LRR_AUTOFIX_PERMISSIONS:-1}

echo "Starting LANraragi with UID/GID : $USER_ID/$GROUP_ID"

#Update the koyomi user, using the specified uid/gid.
#This solves permission problems on the content folder if the Docker user sets the same uid as the owner of the folder.
usermod -o -u $USER_ID koyomi
groupmod -o -g $GROUP_ID koyomi
chown koyomi /home/koyomi/lanraragi

#Crash with an error if content folder doesn't exist
if [ ! -d "/home/koyomi/lanraragi/content" ]; then
  echo "Content folder doesn't exist! Please ensure your Docker mappings are correct."
  exit 1
fi

#Ensure database is writable
chown -R koyomi /home/koyomi/lanraragi/database
chmod -R u+rwx /home/koyomi/lanraragi/database

# CUSTOM FORK (feature/path-hash-id): the three folders below are CONTAINER-OWNED
# data volumes (thumb/, Sideloaded/, Managed/), not the remote content mount.
# Their permission fix therefore runs UNCONDITIONALLY and is deliberately kept
# out of the LRR_AUTOFIX_PERMISSIONS block underneath.
#
# Why this matters: LRR_AUTOFIX_PERMISSIONS is a knob for the content volume,
# where a recursive chown on a 115 FUSE mount can wedge the container in D-state.
# Users who mount a read-only or remote content root therefore set it to -1 to
# disable fixing -- but the old code put thumb/ inside the same guarded block, so
# disabling content fixing silently disabled thumbnail fixing too.
#
# The failure mode is silent and confusing: a freshly created bind-mount target on
# the host keeps the permissions Docker gives it (often 000, owned by the host
# user), LRR runs as koyomi/9001 and cannot mkdir the per-archive subfolder.
# Every page thumbnail then fails with
#   mkdir /home/koyomi/lanraragi/thumb/XX: Permission denied
# at Utils/Archive.pm, the reader gets no thumbnails, and the list page keeps
# serving noThumb.png -- while archive listing, reading and search all still work,
# which makes it look like a frontend cache bug rather than a permissions one.
#
# These folders must also be CREATED here: they live inside the image, so a fresh
# container that maps an empty host directory over them inherits the mount's
# permissions, and the mount may not contain the folder at all.
echo "Ensuring container-owned data folders are writable..."

mkdir -p /home/koyomi/lanraragi/thumb
chown -R koyomi /home/koyomi/lanraragi/thumb
find /home/koyomi/lanraragi/thumb -type f -exec chmod u+rw  {} \;
find /home/koyomi/lanraragi/thumb -type d -exec chmod u+rwx {} \;

mkdir -p /home/koyomi/lanraragi/lib/LANraragi/Plugin/Sideloaded
chown -R koyomi /home/koyomi/lanraragi/lib/LANraragi/Plugin/Sideloaded
chmod u+rwx /home/koyomi/lanraragi/lib/LANraragi/Plugin/Sideloaded
find /home/koyomi/lanraragi/lib/LANraragi/Plugin/Sideloaded -type f -exec chmod u+rwx {} \;

mkdir -p /home/koyomi/lanraragi/lib/LANraragi/Plugin/Managed
chown -R koyomi /home/koyomi/lanraragi/lib/LANraragi/Plugin/Managed
chmod u+rwx /home/koyomi/lanraragi/lib/LANraragi/Plugin/Managed
find /home/koyomi/lanraragi/lib/LANraragi/Plugin/Managed -type f -exec chmod u+rwx {} \;

if [ "$FIX_PERMS" -eq 1 ]; then
  echo "Fixing content permissions, hold on!"

  # Ensure the rest of the content folder is at least readable
  find /home/koyomi/lanraragi/content -name thumb -prune -o -type f -exec chmod u+r  {} \;
  find /home/koyomi/lanraragi/content -name thumb -prune -o -type d -exec chmod u+rx {} \;
else
    echo "Not touching content permissions"
fi

#Ensure log folder is writable
mkdir /home/koyomi/lanraragi/log
chown -R koyomi /home/koyomi/lanraragi/log
chmod u+rwx /home/koyomi/lanraragi/log

#Ensure temp folder is writable
mkdir /home/koyomi/lanraragi/temp
chown -R koyomi /home/koyomi/lanraragi/temp
chmod u+rwx /home/koyomi/lanraragi/temp

#Remove mojo, minion and shinobu pid files
if [ -f /home/koyomi/lanraragi/temp/server.pid ]; then
    rm /home/koyomi/lanraragi/temp/server.pid
fi
if [ -f /home/koyomi/lanraragi/temp/shinobu.pid ]; then
    rm /home/koyomi/lanraragi/temp/shinobu.pid
fi
if [ -f /home/koyomi/lanraragi/temp/shinobu.pid-s6 ]; then
    rm /home/koyomi/lanraragi/temp/shinobu.pid-s6
fi
if [ -f /home/koyomi/lanraragi/temp/minion.pid ]; then
    rm /home/koyomi/lanraragi/temp/minion.pid
fi
if [ -f /home/koyomi/lanraragi/temp/minion.pid-s6 ]; then
  rm /home/koyomi/lanraragi/temp/minion.pid-s6
fi

# https://valkey.io/topics/faq/#background-saving-fails-with-a-fork-error-on-linux
OVERCOMMIT=$(cat /proc/sys/vm/overcommit_memory)
if [ $OVERCOMMIT -eq 0 ]
then
        echo "WARNING: overcommit_memory is set to 0! This might lead to background saving errors if your database is too large."
            echo "Please check https://valkey.io/topics/faq/#background-saving-fails-with-a-fork-error-on-linux for details."
fi
